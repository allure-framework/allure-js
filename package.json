{
  "name": "allure-js",
  "version": "3.15.0",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "audit": "yarn npm audit --all --recursive",
    "clean": "rimraf -g 'packages/*/dist'",
    "build": "yarn run clean && yarn workspaces foreach -Avvp --topological-dev --exclude allure-js exec vp run --cache compile",
    "verify": "vp check",
    "lint": "vp lint",
    "lint:fix": "yarn vp lint --fix",
    "lint:type": "vp lint --type-aware packages",
    "format": "yarn format:write",
    "format:check": "vp fmt --check",
    "format:write": "vp fmt --write",
    "check:dependencies": "sherif",
    "test": "yarn workspaces foreach -Avvt run test"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.0",
    "allure": "^3.14.3",
    "lefthook": "^2.1.4",
    "rimraf": "^6.0.0",
    "sherif": "^1.13.0",
    "typescript": "^6.0.3",
    "vite-plus": "^1.7.0"
  },
