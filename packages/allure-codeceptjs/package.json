{
  "name": "allure-codeceptjs",
  "version": "3.15.0",
  "description": "Allure codeceptjs integration",
  "keywords": [
    "allure",
    "codeceptjs",
    "html",
    "report",
    "reporter",
    "test",
    "testing",
    "testops"
  ],
  "homepage": "https://allurereport.org/",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/allure-framework/allure-js.git",
    "directory": "packages/allure-codeceptjs"
  },
  "files": [
    "dist"
  ],
  "main": "./dist/cjs/index.js",
  "module": "./dist/esm/index.js",
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/esm/index.js",
      "require": "./dist/cjs/index.js"
    }
  },
  "scripts": {
    "allure-report": "allure serve ./out/allure-results",
    "clean": "rimraf ./dist ./out ./test-results",
    "compile": "run-s 'compile:*'",
    "compile:esm": "babel --config-file ./babel.esm.json ./src --out-dir ./dist/esm --extensions .ts --source-maps",
    "compile:cjs": "babel --config-file ./babel.cjs.json ./src --out-dir ./dist/cjs --extensions .ts --source-maps",
    "compile:types": "tsc",
    "compile:fixup": "node ./scripts/fixup.mjs",
    "generate-report": "allure generate ./out/allure-results -o ./out/allure-report --clean",
    "lint": "vp lint src test",
    "lint:fix": "vp lint --fix src test",
    "test": "vp test run"
  },
  "dependencies": {
    "allure-js-commons": "workspace:*",
    "allure-mocha": "workspace:*"
  },
  "devDependencies": {
    "@babel/cli": "^8.0.1",
    "@babel/core": "^7.28.0",
    "@babel/preset-env": "^7.28.0",
    "@babel/preset-typescript": "^7.27.1",
    "@codeceptjs/helper": "^2.0.4",
    "@types/jasmine": "^7.0.0",
    "@types/node": "^26.0.1",
    "allure-commandline": "^2.29.0",
    "allure-vitest": "workspace:*",
    "babel-plugin-add-module-exports": "^1.0.4",
    "codeceptjs": "^4.1.0",
    "codeceptjs-expect": "^1.0.3",
    "npm-run-all2": "^9.0.2",
    "rimraf": "^6.0.0",
    "typescript": "^6.0.3",
    "vite": "npm:@voidzero-dev/vite-plus-core@^8.3.8000",
    "vite-plus": "^1.7.0",
    "vitest": "^5.1.0"
  },
  "peerDependencies": {
    "codeceptjs": ">=2.3.6"
  }
}
