{
  "name": "allure-ava",
  "version": "3.15.0",
  "description": "Allure AVA integration",
  "keywords": [
    "allure",
    "ava",
    "html",
    "report",
    "reporter",
    "test",
    "testing",
    "testops"
  ],
  "homepage": "https://allurereport.org/",
  "license": "Apache-2.0",
  "author": {
    "name": "Qameta Software",
    "email": "allure@qameta.io",
    "url": "https://qameta.io/"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/allure-framework/allure-js.git",
    "directory": "packages/allure-ava"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./setup": {
      "types": "./dist/setup.d.ts",
      "import": "./dist/setup.js",
      "default": "./dist/setup.js"
    },
    "./runtime": {
      "types": "./dist/runtime.d.ts",
      "import": "./dist/runtime.js",
      "default": "./dist/runtime.js"
    }
  },
  "scripts": {
    "allure-report": "allure serve ./out/allure-results",
    "clean": "rimraf ./dist ./out",
    "compile": "tsc --project ./tsconfig.json",
    "generate-report": "allure generate ./out/allure-results -o ./out/allure-report --clean --single-file",
    "lint": "vp lint src test",
    "lint:fix": "vp lint --fix src test",
    "test": "run-s test:prepare test:run",
    "test:prepare": "yarn workspaces foreach -R --topological-dev run compile",
    "test:run": "vp test run"
  },
  "dependencies": {
    "allure-js-commons": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^26.0.1",
    "allure-commandline": "^2.29.0",
    "allure-vitest": "workspace:*",
    "ava": "^8.0.1",
    "npm-run-all2": "^9.0.2",
    "rimraf": "^6.0.0",
    "typescript": "^6.0.3",
    "vite": "npm:@voidzero-dev/vite-plus-core@^8.3.8000",
    "vite-plus": "^1.7.0",
    "vitest": "^5.1.0"
  },
  "peerDependencies": {
    "ava": ">=8.0.0"
  }
}
