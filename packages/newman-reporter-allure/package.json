{
  "name": "newman-reporter-allure",
  "version": "3.15.0",
  "description": "Allure Newman integration",
  "keywords": [
    "allure",
    "api",
    "html",
    "newman",
    "postman",
    "report",
    "reporter",
    "test",
    "testing",
    "testops"
  ],
  "homepage": "https://allurereport.org/",
  "license": "Apache-2.0",
  "author": {
    "name": "Qameta Software",
    "email": "allure@qameta.io",
    "url": "https://qameta.io/"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/allure-framework/allure-js.git",
    "directory": "packages/newman-reporter-allure"
  },
  "files": [
    "dist"
  ],
  "main": "./dist/cjs/index.js",
  "module": "./dist/esm/index.js",
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/esm/index.js",
      "require": "./dist/cjs/index.js"
    }
  },
  "scripts": {
    "allure-report": "allure serve ./out/allure-results",
    "clean": "rimraf ./dist ./out",
    "compile": "run-s 'compile:*'",
    "compile:esm": "babel --config-file ./babel.esm.json ./src --out-dir ./dist/esm --extensions .ts --source-maps",
    "compile:cjs": "babel --config-file ./babel.cjs.json ./src --out-dir ./dist/cjs --extensions .ts --source-maps",
    "compile:types": "tsc",
    "compile:fixup": "node ./scripts/fixup.mjs",
    "generate-report": "allure generate ./out/allure-results -o ./out/allure-report --clean",
    "lint": "vp lint src test",
    "lint:fix": "vp lint --fix src test",
    "test": "run-s test:prepare test:run",
    "test:prepare": "yarn workspaces foreach -R --topological-dev run compile",
    "test:run": "ALLURE_TEST_MODE=1 ALLURE_LABEL_A=a ALLURE_LABEL_B=b vp test run"
  },
  "dependencies": {
    "allure-js-commons": "workspace:*"
  },
  "devDependencies": {
    "@babel/cli": "^8.0.1",
    "@babel/core": "^7.28.0",
    "@babel/preset-env": "^7.28.0",
    "@babel/preset-typescript": "^7.27.1",
    "@types/newman": "^5.3.6",
    "@types/node": "^26.0.1",
    "@types/postman-collection": "^3.5.10",
    "allure-commandline": "^2.29.0",
    "allure-vitest": "workspace:*",
    "babel-plugin-add-module-exports": "^1.0.4",
    "msw": "1",
    "newman": "^6.2.2",
    "npm-run-all2": "^9.0.2",
    "postman-collection": "^5.0.0",
    "rimraf": "^6.0.0",
    "typescript": "^6.0.3",
    "vite": "npm:@voidzero-dev/vite-plus-core@^8.3.8000",
    "vite-plus": "^1.7.0",
    "vitest": "^5.1.0"
  },
  "peerDependencies": {
    "newman": ">=3.5.0"
  },
  "peerDependenciesMeta": {
    "newman": {
      "optional": true
    }
  }
}
