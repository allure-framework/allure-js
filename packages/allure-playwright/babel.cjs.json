{
  "presets": [
    [
      "@babel/preset-typescript",
      {
        "rewriteImportExtensions": true
      }
    ],
    ["@babel/preset-env", { "modules": false }]
  ],
  "plugins": [
    "babel-plugin-transform-import-meta",
    ["@babel/plugin-transform-modules-commonjs", { "lazy": ["@playwright/test"] }]
  ]
}
